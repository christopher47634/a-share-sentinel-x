# AI 研究副驾（/api/ai/chat）。以下两组均不填时走融合持仓与公开公告的本地研究引擎。
# 方式 1（优先）：任意 OpenAI-Compatible 网关（默认 DeepSeek）
AI_API_KEY=
# 不填默认 https://api.deepseek.com/v1
AI_BASE_URL=
# 不填默认 deepseek-chat
AI_MODEL=

# 方式 2（兼容）：OpenAI Responses API
OPENAI_API_KEY=
# 不填默认 gpt-5.5
OPENAI_MODEL=

# 设为 1 开启板块页 Canvas 动效
NEXT_PUBLIC_ENABLE_CANVAS_VISUALS=

# 服务端文件账本（/api/account/ledger）：所有访客共用一个文件，只适合本机单人使用，线上不要开。
# 需要同时设置下面三项，且 LEDGER_TOKEN 与 NEXT_PUBLIC_LEDGER_TOKEN 相同；不设置时账本只保存在浏览器。
ENABLE_SERVER_LEDGER=
LEDGER_TOKEN=
NEXT_PUBLIC_LEDGER_TOKEN=
