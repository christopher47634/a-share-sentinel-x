# AI 研究助手（/api/ai/chat）。不填时走本地规则引擎生成回答。
OPENAI_API_KEY=
# 不填默认 gpt-5.5
OPENAI_MODEL=

# 设为 1 开启板块页 Canvas 动效
NEXT_PUBLIC_ENABLE_CANVAS_VISUALS=

# 服务端文件账本（/api/account/ledger）：所有访客共用一个文件，只适合本机单人使用，线上不要开。
# 需要同时设置下面三项，且 LEDGER_TOKEN 与 NEXT_PUBLIC_LEDGER_TOKEN 相同；不设置时账本只保存在浏览器。
ENABLE_SERVER_LEDGER=
LEDGER_TOKEN=
NEXT_PUBLIC_LEDGER_TOKEN=
